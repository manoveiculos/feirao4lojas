# Número de WhatsApp central do Feirão (somente dígitos com DDI 55 + DDD + número)
# Exemplo: 5547999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5547999999999

# Nome e detalhes do evento exibidos na página
NEXT_PUBLIC_FEIRAO_NOME="Feirão 4 Lojas"
NEXT_PUBLIC_FEIRAO_CIDADE="Rio do Sul - SC"
NEXT_PUBLIC_FEIRAO_PERIODO="Condições Especiais por Tempo Limitado"

# URL pública do site (usada nos links gerados para o chatbot e OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token opcional para proteger o endpoint POST /api/sync
# Deixe vazio para permitir sync sem token em ambiente local
SYNC_SECRET=feirao4lojas-sync-2026
