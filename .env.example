# ==============================================================================
# ACELERA V3 — Variáveis de Ambiente
# ==============================================================================

# ── Site ─────────────────────────────────────────────────────────────────────
# Número ÚNICO de WhatsApp da campanha (55DDDNÚMERO, só dígitos): o mesmo da instância do agente
WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=https://vyro.drivvoo.com
NEXT_PUBLIC_HORARIO_FEIRAO=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
# (opcional) espelho dos leads no n8n; o backend próprio já recebe tudo em /api/leads/capture
N8N_WEBHOOK_URL=
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# ── Acesso aos painéis (/login) ──────────────────────────────────────────────
# Segredo para assinar a sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
# Usuário "admin" + uma senha por loja (usuário = slug da loja, ex: v3-automoveis)
ADMIN_PASSWORD=
LOJA_PASSWORD_MV=
LOJA_PASSWORD_NA=
LOJA_PASSWORD_RA=
LOJA_PASSWORD_V3=

# ── Agente de IA ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Espera (ms) para juntar várias mensagens seguidas do cliente antes de responder
AGENT_DEBOUNCE_MS=5000

# ── WhatsApp: escolha UM provedor ────────────────────────────────────────────
# none | evolution | meta
WHATSAPP_PROVIDER=none
# Evolution API (instância própria)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Segredo do webhook: aponte a Evolution para /api/whatsapp/webhook?secret=<este valor>
WEBHOOK_SECRET=
# WhatsApp Cloud API oficial (Meta)
META_WA_TOKEN=
META_WA_PHONE_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=

# ── Anúncios (Meta) ──────────────────────────────────────────────────────────
# Leitura de gasto/cliques em tempo real (permissão ads_read)
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
# Conversions API: devolve "Lead qualificado" à Meta para otimizar os anúncios
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# Chave da URL do feed de catálogo: /api/feed/meta?key=<este valor>
FEED_KEY=

# ── Agendador / estoque ──────────────────────────────────────────────────────
# Protege /api/cron/tick e /api/sync
CRON_SECRET=
SYNC_SECRET=
# off = desliga o agendador embutido (use cron externo chamando /api/cron/tick)
INTERNAL_CRON=on
AUTO_SYNC_ESTOQUE=on
# Pasta persistente dos leads/mensagens (monte como volume no Docker/VPS)
DATA_DIR=
